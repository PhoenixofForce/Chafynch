{
	"name": "tea-tracker-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src",
		"lint-fix": "eslint src --fix",
		"format": "prettier --check src",
		"format-fix": "prettier --write src",
		"ci": "npm run check && npm run lint && npm run build && npm run format",
		"fix": "npm run lint-fix && npm run format-fix",
		"generate:api": "npx openapi-typescript http://localhost:8080/v3/api-docs -o src/lib/api/schema.d.ts && node scripts/extract-types.cjs",
		"generate:countries": "node scripts/generate-countries.cjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^24",
		"daisyui": "^5.5.19",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.577.0",
		"dompurify": "^3.4.12",
		"marked": "^18.0.6",
		"openapi-fetch": "^0.17.0"
	}
}
