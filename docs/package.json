{
	"name": "docs",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.12.0"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --check src \"!src/styles/custom.gen.css\" astro.config.mjs",
		"format-fix": "prettier --write src \"!src/styles/custom.gen.css\" astro.config.mjs",
		"fix": "npm run format-fix",
		"license-file": "npx --yes license-checker-rseidelsohn@5.0.1 --excludePrivatePackages --plainVertical",
		"license-check": "npx --yes license-checker-rseidelsohn@5.0.1 --excludePrivatePackages --excludePackagesStartingWith \"@img/\" --summary --onlyAllow \"MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;MPL-2.0;(MPL-2.0 OR Apache-2.0);(MIT OR CC0-1.0)\"",
		"update": "ncu -i --cooldown 14 --peer --no-deprecated --format group",
		"update:minor": "npm run update -- --target minor",
		"update:patch": "npm run update -- --target patch"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.41.10",
		"astro": "^7.1.6",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"prettier": "^3.9.6"
	},
	"allowScripts": {
		"esbuild": true
	}
}
